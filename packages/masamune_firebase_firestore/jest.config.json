{
    "moduleNameMapper": {},
    "moduleDirectories": [
        "src",
        "node_modules"
    ],
    "moduleFileExtensions": [
        "js",
        "ts"
    ],
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
        "<rootDir>/test"
    ],
    "transform": {
        "^.+\\.(ts|tsx)$": "ts-jest",
        "^.+/node_modules/jose/.+\\.js$": [
            "ts-jest",
            {
                "tsconfig": {
                    "allowJs": true,
                    "module": "CommonJS"
                }
            }
        ]
    },
    "setupFiles": [
        "<rootDir>/test/firebase_admin_compat.ts"
    ],
    "transformIgnorePatterns": [
        "/node_modules/(?!jose/)"
    ]
}
