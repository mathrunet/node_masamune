{
  "rootDir": "../..",
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/test/unit"],
  "transform": {
    "^.+\\.(ts|tsx)$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ES2022"
        }
      }
    ],
    "^.+/node_modules/jose/.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "CommonJS"
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!jose/)"
  ],
  "extensionsToTreatAsEsm": [
    ".ts"
  ]
}
